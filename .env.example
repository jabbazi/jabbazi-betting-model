JABAZI_ENV=development
# Local development only; production requires PostgreSQL.
JABBAZI_PLATFORM_DATABASE_URL=sqlite:///platform-local.db
JABBAZI_POSTGRES_PASSWORD=
JABAZI_OPERATIONAL_TIMEZONE=America/Chicago
JABAZI_UNIT_SIZE=30.00
JABAZI_BANKROLL=1000.00
JABAZI_DAILY_EXPOSURE_LIMIT=0.20
JABAZI_MIN_EDGE=0.02
JABAZI_CREDIT_RESERVE=50
JABAZI_MAX_CREDITS_PER_RUN=30
# Shared conservative UTC calendar-month ceiling; match your provider allowance.
JABBAZI_MONTHLY_CREDIT_LIMIT=3000
JABBAZI_SCAN_INTERVAL_SECONDS=7200
JABBAZI_SCAN_MAX_CREDITS=9
JABAZI_ODDS_API_KEY=
JABAZI_BOOKMAKERS=draftkings,fanduel,williamhill_us,betmgm,betrivers,espnbet
JABBAZI_SPORTSDATAIO_API_KEY=
JABBAZI_MLB_MODEL_ARTIFACT=models/mlb_moneyline.json
JABBAZI_MODEL_TOKEN=
JABBAZI_JURISDICTION=LA
JABBAZI_CURRENT_DRAWDOWN=0
JABBAZI_RISK_PER_BET=0.02
JABBAZI_RISK_THESIS=0.04
JABBAZI_RISK_PARLAYS=0.03
JABBAZI_RISK_SPORT=0.10
JABBAZI_RISK_EVENT=0.05
JABBAZI_RISK_PLAYER=0.03
JABBAZI_RISK_KELLY_FRACTION=0.10
JABBAZI_RISK_DRAWDOWN_STOP=0.20

# Independent league baselines. Research only; these do not authorize bets.
JABBAZI_MLB_BASELINE=models/mlb_baseline.json
JABBAZI_NFL_BASELINE=models/nfl_baseline.json
JABBAZI_CFB_BASELINE=models/cfb_baseline.json
JABBAZI_CFBD_API_KEY=
# JSON dictionaries: provider team name -> history team name.
JABBAZI_NFL_ALIASES=
JABBAZI_CFB_ALIASES=
# JSON dictionaries keyed by Odds API event ID: {"neutral_site": false}.
JABBAZI_NFL_EVENT_CONTEXT=
JABBAZI_CFB_EVENT_CONTEXT=

# Keep these on the host. Never paste them into Discord or commit them.
JABBAZI_DISCORD_BOT_TOKEN=
JABBAZI_DISCORD_GUILD_ID=
JABBAZI_DISCORD_OWNER_ID=
JABBAZI_DISCORD_REVIEW_WEBHOOK=
JABBAZI_DISCORD_REVIEW_CHANNEL_ID=
JABBAZI_DISCORD_ANALYST_ROLE_ID=
JABBAZI_DISCORD_REVIEW_ENABLED=false

# Official card delivery: opt in only after reviewing all three private targets.
JABBAZI_DISCORD_MAIN_CARD_CHANNEL_ID=
JABBAZI_DISCORD_SPRINKLES_CHANNEL_ID=
JABBAZI_DISCORD_PICK_UPDATES_CHANNEL_ID=
# Both API and worker need the same guild/owner/VIP-role configuration.
# The API also needs the bot token for a live membership check on every request.
JABBAZI_DISCORD_VIEWER_ROLE_IDS=
